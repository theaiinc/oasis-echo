{
  "name": "@theaiinc/oasis-echo-sdk",
  "version": "0.2.0",
  "description": "Client SDK for the oasis-echo voice AI server \u2014 works in browsers and Node.js backends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theaiinc/oasis-echo.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
