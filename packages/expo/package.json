{
  "name": "@theaiinc/oasis-echo-expo",
  "version": "0.2.0",
  "description": "Voice with an oasis-echo server from Expo apps (Android and iOS): the connection (events, actions, audio socket) and whole calls with the phone's speech recognition and voice, or the server's voice",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "default": "./dist/expo.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo": ">=52",
    "expo-audio": "*",
    "expo-file-system": "*",
    "expo-speech": "*",
    "expo-speech-recognition": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-speech": {
      "optional": true
    },
    "expo-speech-recognition": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theaiinc/oasis-echo.git",
    "directory": "packages/expo"
  },
  "publishConfig": {
    "access": "public"
  }
}
